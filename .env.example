# LLM keys (only needed for cloud providers)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local model host
OLLAMA_BASE_URL=http://localhost:11434

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bybit API (create the key in Bybit > API Management; never paste it in chat)
BYBIT_API_KEY=
# HMAC auth: set the secret. RSA auth: leave secret blank, set the key path.
BYBIT_API_SECRET=
BYBIT_PRIVATE_KEY_PATH=
# Safety defaults: testnet on, live execution off. Flip deliberately.
BYBIT_TESTNET=true
BYBIT_EXECUTION_ENABLED=false
BYBIT_RECV_WINDOW=5000

# Nansen API (on-chain analytics; key from your Nansen account, not chat)
NANSEN_API_KEY=
NANSEN_BASE_URL=https://api.nansen.ai/api/v1

# Optional runtime overrides
POLY_BANKROLL_USD=10000
POLY_EDGE_THRESHOLD=0.08
POLY_KELLY_FRACTION=0.25
POLY_LLM_PROVIDER=ollama
POLY_LLM_MODEL=llama3.1:70b
POLY_DRY_RUN=true
POLY_EXECUTION_ENABLED=false
POLY_TELEGRAM_ENABLED=false
